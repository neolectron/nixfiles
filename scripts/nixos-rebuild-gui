#!/usr/bin/env bash
set -euo pipefail

if (( $# != 3 )) || [[ "$2" != "--flake" ]] || [[ "$3" != ".#frostbit" ]]; then
  echo "Usage: scripts/nixos-rebuild-gui <dry-activate|switch> --flake .#frostbit" >&2
  echo "First:   scripts/nixos-rebuild-gui dry-activate --flake .#frostbit" >&2
  echo "Then:    scripts/nixos-rebuild-gui switch --flake .#frostbit" >&2
  exit 2
fi

case "$1" in
  dry-activate|switch)
    ;;
  *)
    echo "The GUI-authorized workflow supports only dry-activate and switch." >&2
    exit 2
    ;;
esac

action="$1"
installed_helper="/run/current-system/sw/bin/nixfiles-rebuild-root"

if [[ -x "$installed_helper" ]]; then
  exec /run/wrappers/bin/pkexec "$(readlink -f "$installed_helper")" "$action"
fi

# Bootstrap a system that does not have the dedicated Polkit action yet.
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
caller_user="$(id -un)"
privileged_path="/etc/profiles/per-user/${caller_user}/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin"

exec /run/wrappers/bin/pkexec \
  /run/current-system/sw/bin/env \
  "PATH=${privileged_path}" \
  /run/current-system/sw/bin/nixos-rebuild "$action" \
  --flake "path:${repo_root}#frostbit"
