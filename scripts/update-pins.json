{
  "denylist": ["opencodex"],
  "updates": [
    {
      "name": "codeburn",
      "type": "nix-update",
      "description": "CodeBurn tagged source, npm artifact, and dependency closure",
      "systems": ["x86_64-linux"],
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "codeburn",
        "--use-update-script"
      ]
    },
    {
      "name": "opencode-v2",
      "type": "nix-update",
      "description": "OpenCode V2 current-platform npm binary",
      "systems": ["x86_64-linux"],
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "opencode-v2",
        "--use-update-script"
      ]
    },
    {
      "name": "opencodex",
      "type": "nix-update",
      "description": "OpenCodex release, lockfile, and Bun dependency closure",
      "systems": ["x86_64-linux"],
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "opencodex",
        "--use-update-script"
      ]
    },
    {
      "name": "wifi-audio-streaming",
      "type": "nix-update",
      "description": "WiFi Audio Streaming AppImage release",
      "systems": ["x86_64-linux"],
      "command": [
        "nix",
        "run",
        "github:Mic92/nix-update",
        "--",
        "--flake",
        "wifi-audio-streaming",
        "--use-update-script"
      ]
    },
    {
      "name": "flake-inputs",
      "type": "flake-inputs",
      "description": "Update direct flake inputs using the repository policy",
      "systems": ["x86_64-linux"],
      "command": ["./scripts/update-flake-inputs"]
    }
  ],
  "validations": {
    "fast": [
      {
        "name": "flake check",
        "command": ["nix", "flake", "check", "--no-build"],
        "systems": ["x86_64-linux"]
      },
      {
        "name": "CodeBurn evaluation",
        "command": ["nix", "eval", ".#codeburn.drvPath", "--raw"],
        "systems": ["x86_64-linux"]
      },
      {
        "name": "OpenCode V2 evaluation",
        "command": ["nix", "eval", ".#opencode-v2.drvPath", "--raw"],
        "systems": ["x86_64-linux"]
      },
      {
        "name": "OpenCodex evaluation",
        "command": ["nix", "eval", ".#opencodex.drvPath", "--raw"],
        "systems": ["x86_64-linux"]
      },
      {
        "name": "WiFi Audio Streaming evaluation",
        "command": ["nix", "eval", ".#wifi-audio-streaming.drvPath", "--raw"],
        "systems": ["x86_64-linux"]
      }
    ],
    "full": [
      {
        "name": "frostbit system build",
        "command": [
          "nix",
          "build",
          ".#nixosConfigurations.frostbit.config.system.build.toplevel",
          "--no-link"
        ],
        "systems": ["x86_64-linux"]
      }
    ]
  }
}
