{
  "name": "nixfiles-tools",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "pnpm --filter @nixfiles/streamdeck build && pnpm --filter keep-awake-mcp build",
    "typecheck": "pnpm --filter @nixfiles/streamdeck typecheck && pnpm --filter keep-awake-mcp typecheck",
    "test": "pnpm --filter @nixfiles/streamdeck test && pnpm --filter keep-awake-mcp test",
    "keep-awake:build": "pnpm --filter keep-awake-mcp build",
    "keep-awake:test": "pnpm --filter keep-awake-mcp test",
    "keep-awake:smoke": "pnpm --filter keep-awake-mcp smoke",
    "streamdeck": "pnpm --filter @nixfiles/streamdeck cli",
    "streamdeck:demo": "pnpm streamdeck hello --mock --demo"
  }
}
