+// Linux has no POSIX_SPAWN_CLOEXEC_DEFAULT: both ends must close on exec,
+// otherwise the child inherits its own pipe ends and readers never see EOF.
+func commandPipe(_ fds: inout [Int32]) -> Bool {
+    guard pipe(&fds) == 0 else { return false }
+    for fd in fds {
+        if fcntl(fd, F_SETFD, FD_CLOEXEC) == -1 {
+            for fd in fds { close(fd) }
+            return false
+        }
+    }
+    return true
+}
+
+// Each buffer has one writer; result() joins that writer before reading it.
+final class CommandPipeReader: @unchecked Sendable {
+    private let group = DispatchGroup()
+    private var data = Data()
+
+    init(_ fd: Int32) {
+        group.enter()
+        DispatchQueue.global().async {
+            self.data = readFD(fd)
+            close(fd)
+            self.group.leave()
+        }
+    }
+
+    func result() -> Data {
+        group.wait()
+        return data
+    }
+}
