    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.4",
    "@elgato-stream-deck/node": "7.8.0",
    "effect": "4.0.4",
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
