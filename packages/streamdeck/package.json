{
  "name": "@nixfiles/streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
