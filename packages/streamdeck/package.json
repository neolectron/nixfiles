{
  "name": "@nixfiles/streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./presentation": "./src/presentation.tsx",
    "./react-mixer": "./src/react-mixer.tsx",
    "./studio-actions": "./src/studio-actions.tsx",
    "./plugins/spotify-lcd": "./src/plugins/spotify-lcd.tsx",
    "./ui/*": "./src/ui/*.tsx",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "node --import tsx --watch --watch-preserve-output src/cli.ts mixer",
    "studio:dev": "node --import tsx --watch --watch-preserve-output src/cli.ts studio",
    "cli": "node --import tsx src/cli.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "oxlint -c ../../.oxlintrc.json src web vitest.config.ts",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --check -c ../../.oxfmtrc.json .",
    "format:fix": "oxfmt -c ../../.oxfmtrc.json ."
  },
  "dependencies": {
    "@effect/platform-node": "4.0.4",
    "@elgato-stream-deck/node": "7.8.0",
    "@nixfiles/system-control": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@takumi-rs/core": "2.15.2",
    "@takumi-rs/helpers": "2.15.2",
    "effect": "4.0.4",
    "fast-png": "8.0.0",
    "node-hid": "3.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
