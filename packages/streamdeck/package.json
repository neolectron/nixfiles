{
  "name": "@nixfiles/streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output src/cli.ts mixer",
    "studio:dev": "node --watch --watch-preserve-output src/cli.ts studio",
    "cli": "node src/cli.ts",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.4",
    "@elgato-stream-deck/node": "7.8.0",
    "@resvg/resvg-js": "2.6.2",
    "@takumi-rs/core": "2.15.2",
    "@takumi-rs/helpers": "2.15.2",
    "effect": "4.0.4",
    "fast-png": "8.0.0",
    "node-hid": "3.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
